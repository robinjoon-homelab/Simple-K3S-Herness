{
  "contractVersion": 1,
  "metadata": {
    "name": "notion-blog",
    "namespace": "notion-blog"
  },
  "workload": {
    "kind": "deployment",
    "replicas": 1,
    "containers": [
      {
        "name": "app",
        "image": {
          "repository": "registry.homelab.robinjoon.xyz/apps/notion-blog",
          "tag": "sha-878484fb78b04b647863d953b0beb46d4a5af7d4-run-42928879762-1"
        },
        "ports": [
          {
            "name": "http",
            "containerPort": 8080
          }
        ],
        "env": [
          {
            "name": "DB_PORT",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "port"
            }
          },
          {
            "name": "SPRING_DATASOURCE_URL",
            "value": "jdbc:postgresql://$(DB_HOST):$(DB_PORT)/notion_blog"
          },
          {
            "name": "SPRING_DATASOURCE_USERNAME",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "username"
            }
          },
          {
            "name": "SPRING_DATASOURCE_PASSWORD",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "password"
            }
          },
          {
            "name": "NOTION_TOKEN",
            "secretKeyRef": {
              "name": "notion-blog-runtime",
              "key": "NOTION_TOKEN"
            }
          },
          {
            "name": "NOTION_SETTINGS_DATA_SOURCE_ID",
            "secretKeyRef": {
              "name": "notion-blog-runtime",
              "key": "NOTION_SETTINGS_DATA_SOURCE_ID"
            }
          },
          {
            "name": "NOTION_API_VERSION",
            "value": "2026-03-11"
          },
          {
            "name": "BLOG_SYNCHRONIZATION_INTERVAL_MS",
            "value": "60000"
          },
          {
            "name": "BLOG_SYNCHRONIZATION_SUCCESS_INTERVAL",
            "value": "1m"
          },
          {
            "name": "BLOG_BASE_URL",
            "value": "https://blog.homelab.robinjoon.xyz"
          },
          {
            "name": "SPRING_PROFILES_ACTIVE",
            "value": "prod"
          },
          {
            "name": "NOTION_POSTS_DATA_SOURCE_ID",
            "secretKeyRef": {
              "name": "notion-blog-runtime",
              "key": "NOTION_POSTS_DATA_SOURCE_ID"
            }
          },
          {
            "name": "ADMIN_USERNAME",
            "secretKeyRef": {
              "name": "notion-blog-runtime",
              "key": "ADMIN_USERNAME"
            }
          },
          {
            "name": "ADMIN_PASSWORD",
            "secretKeyRef": {
              "name": "notion-blog-runtime",
              "key": "ADMIN_PASSWORD"
            }
          }
        ]
      }
    ],
    "imagePullSecrets": [
      {
        "name": "registry-credentials"
      }
    ]
  },
  "database": {
    "name": "notion_blog"
  },
  "services": [
    {
      "name": "web",
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": "http"
        }
      ]
    }
  ],
  "ingresses": [
    {
      "name": "public",
      "service": "web",
      "rules": [
        {
          "host": "blog.homelab.robinjoon.xyz",
          "paths": [
            {
              "path": "/",
              "servicePort": "http"
            }
          ]
        }
      ],
      "tls": {
        "mode": "cert-manager"
      }
    }
  ]
}

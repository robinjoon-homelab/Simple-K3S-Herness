{
  "contractVersion": 1,
  "metadata": {
    "name": "sms",
    "namespace": "sms"
  },
  "workload": {
    "kind": "deployment",
    "replicas": 1,
    "containers": [
      {
        "name": "app",
        "image": {
          "repository": "registry.homelab.robinjoon.xyz/apps/sms",
          "tag": "sha-9bdc6be8af37b0d736c37b822ec6be6312cbf2df-run-37914487474-1"
        },
        "ports": [
          {
            "name": "http",
            "containerPort": 8080
          }
        ],
        "env": [
          {
            "name": "DB_PORT",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "port"
            }
          },
          {
            "name": "SPRING_DATASOURCE_URL",
            "value": "jdbc:postgresql://$(DB_HOST):$(DB_PORT)/secret_manage_system"
          },
          {
            "name": "SPRING_DATASOURCE_USERNAME",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "username"
            }
          },
          {
            "name": "SPRING_DATASOURCE_PASSWORD",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "password"
            }
          },
          {
            "name": "SMS_OPERATOR_USERNAME",
            "secretKeyRef": {
              "name": "sms-operator",
              "key": "username"
            }
          },
          {
            "name": "SMS_OPERATOR_PASSWORD_HASH",
            "secretKeyRef": {
              "name": "sms-operator",
              "key": "password-hash"
            }
          },
          {
            "name": "SERVER_TOMCAT_USE_RELATIVE_REDIRECTS",
            "value": "true"
          }
        ],
        "volumeMounts": []
      }
    ],
    "imagePullSecrets": [
      {
        "name": "registry-credentials"
      }
    ],
    "volumes": [],
    "serviceAccountName": "sms-secret-manager"
  },
  "database": {
    "name": "secret_manage_system"
  },
  "configMaps": [],
  "services": [
    {
      "name": "web",
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": "http"
        }
      ]
    }
  ],
  "ingresses": [
    {
      "name": "public",
      "service": "web",
      "rules": [
        {
          "host": "secrets.homelab.robinjoon.xyz",
          "paths": [
            {
              "path": "/",
              "servicePort": "http"
            }
          ]
        }
      ],
      "tls": {
        "mode": "cert-manager"
      }
    }
  ]
}

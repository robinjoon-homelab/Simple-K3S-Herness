{
  "contractVersion": 1,
  "metadata": {
    "name": "agent-docs",
    "namespace": "agent-docs"
  },
  "workload": {
    "kind": "deployment",
    "replicas": 1,
    "containers": [
      {
        "name": "app",
        "image": {
          "repository": "registry.homelab.robinjoon.xyz/apps/agent-docs",
          "tag": "sha-600bf3eb77c7159acbadd0828bb54811ed3eb072-run-41012849430-1"
        },
        "ports": [
          {
            "name": "http",
            "containerPort": 8080
          }
        ],
        "env": [
          {
            "name": "SPRING_PROFILES_ACTIVE",
            "value": "prod"
          },
          {
            "name": "DB_PORT",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "port"
            }
          },
          {
            "name": "SPRING_DATASOURCE_URL",
            "value": "jdbc:postgresql://$(DB_HOST):$(DB_PORT)/agent_docs"
          },
          {
            "name": "SPRING_DATASOURCE_USERNAME",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "username"
            }
          },
          {
            "name": "SPRING_DATASOURCE_PASSWORD",
            "secretKeyRef": {
              "name": "shared-db-app",
              "key": "password"
            }
          },
          {
            "name": "AGENT_DOCS_OWNER",
            "value": "robinjoon"
          },
          {
            "name": "AGENT_DOCS_PUBLIC_URL",
            "value": "https://agent-docs.homelab.robinjoon.xyz"
          },
          {
            "name": "GITHUB_CLIENT_ID",
            "secretKeyRef": {
              "name": "agent-docs-runtime",
              "key": "GITHUB_CLIENT_ID"
            }
          },
          {
            "name": "GITHUB_CLIENT_SECRET",
            "secretKeyRef": {
              "name": "agent-docs-runtime",
              "key": "GITHUB_CLIENT_SECRET"
            }
          },
          {
            "name": "AGENT_DOCS_ASSET_STORE",
            "value": "s3"
          },
          {
            "name": "AGENT_DOCS_S3_BUCKET",
            "value": "agent-docs"
          },
          {
            "name": "AGENT_DOCS_S3_ENDPOINT",
            "value": "http://juicefs-gateway.storage-system.svc.cluster.local:9000"
          },
          {
            "name": "AGENT_DOCS_S3_ACCESS_KEY",
            "secretKeyRef": {
              "name": "juicefs-gateway-auth",
              "key": "access-key"
            }
          },
          {
            "name": "AGENT_DOCS_S3_SECRET_KEY",
            "secretKeyRef": {
              "name": "juicefs-gateway-auth",
              "key": "secret-key"
            }
          }
        ]
      }
    ],
    "imagePullSecrets": [
      {
        "name": "registry-credentials"
      }
    ]
  },
  "database": {
    "name": "agent_docs"
  },
  "services": [
    {
      "name": "web",
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": "http"
        }
      ]
    }
  ],
  "ingresses": [
    {
      "name": "public",
      "service": "web",
      "rules": [
        {
          "host": "agent-docs.homelab.robinjoon.xyz",
          "paths": [
            {
              "path": "/",
              "servicePort": "http"
            }
          ]
        }
      ],
      "tls": {
        "mode": "cert-manager"
      }
    }
  ]
}
